CREATE SCHEMA `permit_account_service` ;
CREATE TABLE `permit_account_service`.`users` (
  `user_name` VARCHAR(45) NULL DEFAULT NULL,
  `user_role` VARCHAR(20) NULL DEFAULT NULL,
  `is_active` BIT(1) NULL DEFAULT NULL,
  `created_by` INT NULL DEFAULT NULL,
  `created_on` DATETIME NULL DEFAULT CURRENT_TIMESTAMP,
  `id` INT NOT NULL AUTO_INCREMENT,
  PRIMARY KEY (`id`));

CREATE SCHEMA `permit_repository_service` ;
 CREATE TABLE `permit_account_service`.`city_master` (
  `id` INT NOT NULL AUTO_INCREMENT,
  `city` VARCHAR(45) NULL DEFAULT NULL,
  `state` VARCHAR(45) NULL DEFAULT NULL,
  `country` VARCHAR(45) NULL DEFAULT NULL,
  `created_on` DATETIME NULL DEFAULT CURRENT_TIMESTAMP,
  `created_by` INT NULL DEFAULT NULL,
  PRIMARY KEY (`id`));

  CREATE TABLE `permit_account_service`.`permit_master` (
  `id` INT NOT NULL AUTO_INCREMENT,
  `category` VARCHAR(45) NULL DEFAULT NULL,
  `type_of_project` VARCHAR(45) NULL DEFAULT NULL,
  `level` VARCHAR(45) NULL DEFAULT NULL,
  `state` VARCHAR(45) NULL DEFAULT NULL,
  `county` VARCHAR(45) NULL DEFAULT NULL,
  `city` VARCHAR(45) NULL DEFAULT NULL,
  `permit_name` VARCHAR(100) NULL DEFAULT NULL,
  `regulatory_agency_name` VARCHAR(100) NULL DEFAULT NULL,
  `regulatory_agency_id` INT NULL DEFAULT NULL,
  PRIMARY KEY (`id`));

  ALTER TABLE `permit_account_service`.`permit_master` 
  ADD COLUMN `created_by` INT NULL DEFAULT NULL AFTER `regulatory_agency_id`,
  ADD COLUMN `created_on` DATETIME NULL DEFAULT CURRENT_TIMESTAMP AFTER `created_by`;


  CREATE TABLE `permit_account_service`.`permit_details` (
  `id` INT NOT NULL AUTO_INCREMENT,
  `permit_id` INT NULL DEFAULT NULL,
  `description` VARCHAR(200) NULL DEFAULT NULL,
  `threshold` VARCHAR(200) NULL DEFAULT NULL,
  `prep_time_min` INT NULL DEFAULT NULL,
  `prep_time_max` INT NULL DEFAULT NULL,
  `agency_review_time_min` INT NULL DEFAULT NULL,
  `agency_review_time_max` INT NULL DEFAULT NULL,
  `basic_fees` DECIMAL(8,3) NULL DEFAULT NULL,
  `additional_basic` VARCHAR(200) NULL DEFAULT NULL,
  PRIMARY KEY (`id`));

  CREATE TABLE `permit_account_service`.`regulatory_agency_master` (
  `id` INT NOT NULL AUTO_INCREMENT,
  `name` VARCHAR(100) NULL DEFAULT NULL,
  `address` VARCHAR(200) NULL DEFAULT NULL,
  `contact` VARCHAR(45) NULL DEFAULT NULL,
  `link` VARCHAR(100) NULL DEFAULT NULL,
  `department` VARCHAR(45) NULL DEFAULT NULL,
  PRIMARY KEY (`id`));

  CREATE TABLE `permit_account_service`.`permit_matrix` (
  `id` INT NOT NULL AUTO_INCREMENT,
  `type_of_project` VARCHAR(100) NULL DEFAULT NULL,
  `matrix_name` VARCHAR(100) NULL DEFAULT NULL,
  `client_id` INT NULL DEFAULT NULL,
  `permit_list` VARCHAR(200) NULL DEFAULT NULL,
  `created_by` INT NULL DEFAULT NULL,
  `created_on` DATETIME NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`));

ALTER TABLE `permit_account_service`.`regulatory_agency_master` 
ADD COLUMN `contact_person` VARCHAR(100) NULL DEFAULT NULL AFTER `department`,
CHANGE COLUMN `name` `name` VARCHAR(250) NULL DEFAULT NULL ,
CHANGE COLUMN `address` `address` VARCHAR(250) NULL DEFAULT NULL ;


ALTER TABLE `permit_account_service`.`permit_master` 
CHANGE COLUMN `type_of_project` `type_of_project` VARCHAR(100) NULL DEFAULT NULL ;

ALTER TABLE `permit_account_service`.`permit_matrix` 
ADD COLUMN `status` TINYINT NULL DEFAULT NULL AFTER `client_name`;

ALTER TABLE `permit_account_service`.`permit_matrix` 
CHANGE COLUMN `permit_list` `permit_list` VARCHAR(1000) NULL DEFAULT NULL ;





